      value: 109.45374
      objectReference: {fileID: 0}
    - target: {fileID: 804437816494134236, guid: c356f47c3ed30b342aa32d0219cb91b7, type: 3}
      propertyPath: m_LocalPosition.z
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 804437816494134236, guid: c356f47c3ed30b342aa32d0219cb91b7, type: 3}
      propertyPath: m_LocalRotation.w
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 804437816494134236, guid: c356f47c3ed30b342aa32d0219cb91b7, type: 3}
      propertyPath: m_LocalRotation.x
      value: -0
      objectReference: {fileID: 0}
    - target: {fileID: 804437816494134236, guid: c356f47c3ed30b342aa32d0219cb91b7, type: 3}
      propertyPath: m_LocalRotation.y
      value: -0
      objectReference: {fileID: 0}
    - target: {fileID: 804437816494134236, guid: c356f47c3ed30b342aa32d0219cb91b7, type: 3}
      propertyPath: m_LocalRotation.z
      value: -0
      objectReference: {fileID: 0}
    - target: {fileID: 804437816494134236, guid: c356f47c3ed30b342aa32d0219cb91b7, type: 3}
      propertyPath: m_LocalEulerAnglesHint.x
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 804437816494134236, guid: c356f47c3ed30b342aa32d0219cb91b7, type: 3}
      propertyPath: m_LocalEulerAnglesHint.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 804437816494134236, guid: c356f47c3ed30b342aa32d0219cb91b7, type: 3}
      propertyPath: m_LocalEulerAnglesHint.z
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1124090668165097416, guid: c356f47c3ed30b342aa32d0219cb91b7, type: 3}
      propertyPath: saludoInicial.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 1124090668165097416, guid: c356f47c3ed30b342aa32d0219cb91b7, type: 3}
      propertyPath: 'saludoInicial.Array.data[0]'
      value: "\xA1Vaya, vaya! No esperaba volver a ver esos pelos \nde artista por
        aqu\xED arriba. \nPareces un poco m\xE1s cansado, \npero al menos sigues
        de una pieza."
      objectReference: {fileID: 0}
    - target: {fileID: 1124090668165097416, guid: c356f47c3ed30b342aa32d0219cb91b7, type: 3}
      propertyPath: 'saludoInicial.Array.data[1]'
      value: "\xBFHas visto el portal, verdad? El aire se ha vuelto pesado... \nes
        una se\xF1al de que el due\xF1o del bosque sabe que est\xE1s aqu\xED.\nAc\xE9rcate
        a la lumbre antes de que se te hiele la sangre."
      objectReference: {fileID: 0}
    - target: {fileID: 1124090668165097416, guid: c356f47c3ed30b342aa32d0219cb91b7, type: 3}
      propertyPath: opciones.Array.data[0].textoDelBoton
      value: "\xBFQu\xE9 es ese portal de ah\xED?"
      objectReference: {fileID: 0}
    - target: {fileID: 1124090668165097416, guid: c356f47c3ed30b342aa32d0219cb91b7, type: 3}
      propertyPath: opciones.Array.data[1].textoDelBoton
      value: "Sigo buscando al p\xE1jaro que me rob\xF3 el lienzo."
      objectReference: {fileID: 0}
    - target: {fileID: 1124090668165097416, guid: c356f47c3ed30b342aa32d0219cb91b7, type: 3}
      propertyPath: opciones.Array.data[2].textoDelBoton
      value: "Me voy. Des\xE9ame suerte, Abuela."
      objectReference: {fileID: 0}
    - target: {fileID: 1124090668165097416, guid: c356f47c3ed30b342aa32d0219cb91b7, type: 3}
      propertyPath: 'opciones.Array.data[0].frasesRespuesta.Array.data[0]'
      value: "\xBFEsa vueva de ah\xED? \nEs la puerta trasera de esta monta\xF1a,
        jovencito. \nY cre\xE9me, no quieres saber qu\xE9 hay al otro lado."
      objectReference: {fileID: 0}
    - target: {fileID: 1124090668165097416, guid: c356f47c3ed30b342aa32d0219cb91b7, type: 3}
      propertyPath: 'opciones.Array.data[0].frasesRespuesta.Array.data[1]'
      value: "El aire all\xED dentro... huele a podrido y a desesperaci\xF3n. \nSi
        es el p\xE1jaro ese lo que buscas puede que lo que hay \ndentro sea un obst\xE1culo
        en tu camino."
      objectReference: {fileID: 0}
    - target: {fileID: 1124090668165097416, guid: c356f47c3ed30b342aa32d0219cb91b7, type: 3}
      propertyPath: 'opciones.Array.data[0].frasesRespuesta.Array.data[2]'
      value: "He visto a muchos guerreros con el ego \npor las nubes cruzar ese portal.
        \nNinguno ha vuelto para contarme c\xF3mo les fue. \nPrep\xE1rate bien antes
        de dar un paso m\xE1s."
      objectReference: {fileID: 0}
    - target: {fileID: 1124090668165097416, guid: c356f47c3ed30b342aa32d0219cb91b7, type: 3}
      propertyPath: 'opciones.Array.data[1].frasesRespuesta.Array.data[0]'
      value: "Sigues con la misma cantinela... \nEres terco como una mula, te lo
        concedo. \nPues est\xE1s de suerte, porque este \nes el camino a seguir subiendo."
      objectReference: {fileID: 0}
    - target: {fileID: 1124090668165097416, guid: c356f47c3ed30b342aa32d0219cb91b7, type: 3}
      propertyPath: 'opciones.Array.data[1].frasesRespuesta.Array.data[2]'
      value: "Pero no te conf\xEDes. \nLo que manda ah\xED dentro reina sobre el
        bosque \ny no te dejar\xE1 pasar tan f\xE1cilmente."
      objectReference: {fileID: 0}
    - target: {fileID: 1124090668165097416, guid: c356f47c3ed30b342aa32d0219cb91b7, type: 3}
      propertyPath: 'opciones.Array.data[1].frasesRespuesta.Array.data[3]'
      value: "No te quedes plantado como un pasmarote \ncuando las cosas se pongan
        feas. \nMantente en movimiento, esquiva y espera el momento justo. \nEl cielo
        no ser\xE1 tuyo si no aprendes a bailar en \xE9l."
      objectReference: {fileID: 0}
    - target: {fileID: 1124090668165097416, guid: c356f47c3ed30b342aa32d0219cb91b7, type: 3}
      propertyPath: 'opciones.Array.data[2].frasesRespuesta.Array.data[0]'
      value: "\xBFSuerte? La suerte es para los que no saben lo que hacen. \nT\xFA
        vas a necesitar un milagro y tener los reflejos bien afilados."
      objectReference: {fileID: 0}
    - target: {fileID: 1124090668165097416, guid: c356f47c3ed30b342aa32d0219cb91b7, type: 3}
      propertyPath: 'opciones.Array.data[2].frasesRespuesta.Array.data[1]'
      value: "Anda, ve. Recupera tu dichoso lienzo de una vez por todas. \nYa estoy
        harta de ver tu cara de preocupado por aqu\xED."
      objectReference: {fileID: 0}
    - target: {fileID: 1124090668165097416, guid: c356f47c3ed30b342aa32d0219cb91b7, type: 3}
      propertyPath: 'opciones.Array.data[2].frasesRespuesta.Array.data[2]'
      value: "Y oye... si logras salir de esta... \nprocura volver de una pieza,
        \xBFentendido? \nAlguien tiene que contarme qu\xE9 demonios hab\xEDa ah\xED
        dentro."
      objectReference: {fileID: 0}
    - target: {fileID: 5939664471755992064, guid: c356f47c3ed30b342aa32d0219cb91b7, type: 3}
      propertyPath: m_SortingOrder
      value: 15
      objectReference: {fileID: 0}
    - target: {fileID: 7096754242668403784, guid: c356f47c3ed30b342aa32d0219cb91b7, type: 3}
      propertyPath: m_Size.x
      value: 12.044861
      objectReference: {fileID: 0}
    - target: {fileID: 7096754242668403784, guid: c356f47c3ed30b342aa32d0219cb91b7, type: 3}
      propertyPath: m_Offset.x
      value: 0.06112671
      objectReference: {fileID: 0}
    - target: {fileID: 8306674894419171053, guid: c356f47c3ed30b342aa32d0219cb91b7, type: 3}
      propertyPath: m_Name
      value: Abuela (1)
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: c356f47c3ed30b342aa32d0219cb91b7, type: 3}
